---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export type ThumbnailShape = 'circle' | 'square';

type Props = {
    src?: ImageMetadata;
    alt?: string;
    shape?: ThumbnailShape;
    /** Rendered box width(s), so the browser fetches a small file. */
    sizes?: string;
    class?: string;
};

const { src, alt = '', shape = 'circle', sizes = '(min-width: 640px) 88px, 72px', class: className } = Astro.props;
---

{
    src && (
        <div class:list={['thumb shrink-0 overflow-hidden border border-main bg-muted', shape === 'circle' ? 'rounded-full' : 'rounded-none', className]}>
            <Image
                src={src}
                alt={alt}
                width={480}
                height={480}
                fit="cover"
                position="center"
                widths={[180, 280]}
                sizes={sizes}
                loading="lazy"
                class="thumb-img block w-full h-full object-cover"
            />
        </div>
    )
}

<style>
    .thumb-img {
        transition: transform 0.25s ease;
    }
    :global(.group:hover) .thumb-img {
        transform: scale(1.04);
    }
    @media (prefers-reduced-motion: reduce) {
        .thumb-img {
            transition: none;
        }
        :global(.group:hover) .thumb-img {
            transform: none;
        }
    }
</style>
